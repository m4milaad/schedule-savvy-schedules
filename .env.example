# Supabase Configuration (existing)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Chatbot RAG System Configuration (new)
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generator Configuration
GENERATOR_PROVIDER=groq
GENERATOR_MODEL=llama-3.1-8b-instant
FALLBACK_GENERATOR_MODEL=llama3-8b-8192

# RAG Configuration
RAG_COLLECTION=university_kb
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Parameters
RAG_RETRIEVAL_K=20
RAG_RERANK_TOP_K=5
RAG_RERANK_CANDIDATES=12
RAG_MAX_CONTEXT_CHARS=12000
RAG_LOCAL_FILES_ONLY=false

# Data Sources
RAG_INCLUDE_MANUAL_RAW=true
RAG_INCLUDE_LEGACY_ROOT_RAW=false
